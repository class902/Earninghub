# ─────────────────────────────────────────────────────────────────────────────
# EarningHub — environment reference. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Website build (public, baked into the static bundle) ────────────────────
# Base URL of the API. Local: http://localhost:8787
VITE_API_URL=http://localhost:8787
# "/" for a custom domain, "/Earninghub/" for github.io project pages (set by build:pages)
VITE_BASE_PATH=/

# ── API secrets (Cloudflare Worker; locally in apps/worker/.dev.vars) ───────
# ADMIN_PASSWORD=       required — admin login password
# SESSION_SECRET=       required — 32+ random chars, signs admin sessions
# RESEND_API_KEY=       optional — enables email (OTP / lead alerts)
# MAIL_FROM=            optional — e.g. "EarningHub <alerts@yourdomain.com>"
